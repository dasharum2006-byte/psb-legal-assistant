# LLM / embeddings / reranker (OpenAI-совместимый прокси)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=cohere/rerank-5-fast
# у эмбеддера/реранкера могут быть отдельные ключи — если пусто, берётся LLM_API_KEY
EMBEDDER_API_KEY=
RERANKER_API_KEY=

# Путь к данным
DATA_DIR=./data

# Поиск
TOP_K=8
RERANKER_TOP_N=5
TEMPERATURE=0
# таймаут одной попытки к LLM (сек) и число попыток
LLM_TIMEOUT=25
LLM_RETRIES=2
MAX_TOKENS=1500

# Гибридный поиск: BM25 + эмбеддинги + реранк.
# Если эндпоинты недоступны, бэкенд молча остаётся на BM25.
USE_SEMANTIC=1
USE_RERANK=1
SEMANTIC_CANDIDATES=12
RERANK_TOP=6
RERANK_FALLBACK=4
SEMANTIC_MIN=0.45
SEMANTIC_STRICT=0.62

# Frontend
VITE_API_BASE=http://localhost:8000
